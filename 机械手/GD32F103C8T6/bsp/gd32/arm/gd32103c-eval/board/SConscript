import os
import rtconfig
from building import *

Import('SDK_LIB')

cwd = GetCurrentDir()

# add general drivers
src = Split('''
board.c
''')

path =  [cwd]

startup_path_prefix = SDK_LIB

if GetDepend(['SOC_GD32103C']):
    startup_name = 'startup_gd32f10x_md.s'
    CPPDEFINES = ['GD32F10X_MD']
else:
    startup_name = 'startup_gd32f10x_hd.s'
    CPPDEFINES = ['GD32F10X_HD']

if rtconfig.PLATFORM in ['gcc']:
    src += [startup_path_prefix + '/GD32F10x_Firmware_Library/CMSIS/GD/GD32F10x/Source/GCC/' + startup_name]
elif rtconfig.PLATFORM in ['armcc', 'armclang']:
    src += [startup_path_prefix + '/GD32F10x_Firmware_Library/CMSIS/GD/GD32F10x/Source/ARM/' + startup_name]
elif rtconfig.PLATFORM in ['iccarm']:
    src += [startup_path_prefix + '/GD32F10x_Firmware_Library/CMSIS/GD/GD32F10x/Source/IAR/' + startup_name]
group = DefineGroup('Drivers', src, depend = [''], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')
